{
  "manifest_version": 3,
  "name": "Poker Now Live Hand Importer",
  "version": "0.0.1",
  "permissions": [
    "downloads",
    "downloads.shelf",
    "storage"
  ],
  "host_permissions": [
    "https://*.pokernow.club/games/*"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "icons": {
    "128": "icon.png"
  },
  "content_scripts": [
    {
      "matches": [
        "https://*.pokernow.club/games/*"
      ],
      "js": [
        "Player.js",
        "index.js",
        "Hand.js"
      ],
      "run_at": "document_start"
    }
  ]
}
